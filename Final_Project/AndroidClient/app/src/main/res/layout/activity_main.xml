<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F2"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phone GUI"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- 위쪽 그래프 영역 -->
    <com.example.androidclient.DistanceGraphView
        android:id="@+id/graphView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginBottom="16dp" />

    <!-- 가운데 레이더 + 연결상태 + 인디케이터 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <com.example.androidclient.RadarView
            android:id="@+id/radarView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RGB"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="6dp" />

            <View
                android:id="@+id/viewDistanceIndicator"
                android:layout_width="28dp"
                android:layout_height="210dp"
                android:background="#45D15A" />
        </LinearLayout>
    </LinearLayout>

    <!-- 상태 텍스트 -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SAFE"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:background="#1B8F1B"
        android:layout_marginBottom="14dp" />

    <!-- 초기화 버튼 -->
    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="상태 초기화"
        android:textSize="18sp"
        android:layout_marginBottom="14dp" />

    <!-- 허용 / 경고 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAllow"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="허용"
            android:textSize="20sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnWarning"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="경고"
            android:textSize="20sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 서버 연결용 숨김/임시 입력칸 -->
    <LinearLayout
        android:id="@+id/layoutConnection"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <EditText
            android:id="@+id/editIp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:text="127.0.0.1"
            android:hint="IP"
            android:textSize="11sp"
            android:singleLine="true"
            android:padding="3dp" />

        <EditText
            android:id="@+id/editPort"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="9000"
            android:hint="Port"
            android:textSize="11sp"
            android:singleLine="true"
            android:inputType="number"
            android:padding="3dp"
            android:layout_marginStart="5dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:text="연결"
            android:textSize="11sp"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="연결 상태: Disconnected"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:background="#F0E68C"
        android:gravity="center"
        android:layout_marginTop="4dp" />

</LinearLayout>